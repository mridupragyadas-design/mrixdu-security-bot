# Get this from @BotFather on Telegram
BOT_TOKEN=123456789:AAExampleTokenReplaceMe

# Optional: public channel username (with @) that users must join to post.
# Bot must be an admin of this channel to check membership.
FORCE_JOIN_CHANNEL=@yourchannel

# Postgres connection string for durable storage (filters, blacklist, stats,
# night mode settings, etc.). Without this, the bot falls back to a local
# JSON file that does NOT survive Render restarts/redeploys.
# On Render: create a free "PostgreSQL" instance, then copy its "Internal
# Database URL" (or "External Database URL" if connecting from elsewhere)
# into this variable in your Background Worker's environment settings.
DATABASE_URL=postgresql://user:password@host:5432/dbname
