{
  "name": "mrixdu-security-bot",
  "version": "2.0.0",
  "description": "Telegram group protection bot (Cloudflare Workers edition)",
  "private": true,
  "scripts": {
    "dev": "wrangler dev",
    "deploy": "wrangler deploy",
    "db:init": "wrangler d1 execute mrixdu-security-bot-db --file=./schema.sql",
    "db:init:remote": "wrangler d1 execute mrixdu-security-bot-db --remote --file=./schema.sql"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^4.20240909.0",
    "typescript": "^5.4.5",
    "wrangler": "^3.78.0"
  }
}
